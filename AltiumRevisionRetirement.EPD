  <ExtensionOptions>
    <ExtensionHRID>AltiumRevisionRetirement</ExtensionHRID><ExtensionKind>ADServer</ExtensionKind>
    <ExtensionSourceLocation>__PROJECT_ROOT__</ExtensionSourceLocation><ExtensionSourceRelativePath/>
    <ExtensionLanguage>C#</ExtensionLanguage><ExtensionIDEVersion>Visual Studio 2015</ExtensionIDEVersion>
    <ExtemsionSDKVersion>4.0.1  (AD 18.0+)</ExtemsionSDKVersion>
    <ExtensionCategoryGUID>793A1F67-0B22-4E01-A5DE-3176A1E8C60D</ExtensionCategoryGUID><ExtensionCategoryName>Extensions</ExtensionCategoryName>
