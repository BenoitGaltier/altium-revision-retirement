<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)'==''">Release</Configuration>
    <Platform>AnyCPU</Platform><OutputType>Library</OutputType>
    <RootNamespace>AltiumRevisionRetirement</RootNamespace><AssemblyName>AltiumRevisionRetirement</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion><OutputPath>bin\$(Configuration)\</OutputPath>
    <Optimize>true</Optimize><WarningLevel>4</WarningLevel><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DebugType>pdbonly</DebugType><LangVersion>5</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Altium.SDK"><HintPath>$(AltiumSdkRoot)\CSharp\Altium.SDK.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Altium.SDK.Interfaces"><HintPath>$(AltiumSdkRoot)\..\Altium.SDK.Interfaces.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="System"/><Reference Include="System.Core"/><Reference Include="System.Drawing"/><Reference Include="System.Windows.Forms"/>
    <Compile Include="src\*.cs"/>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets"/>
  <Target Name="AfterBuild"><Copy SourceFiles="Installation\AltiumRevisionRetirement.ins;Installation\AltiumRevisionRetirement.rcs" DestinationFolder="$(OutputPath)"/></Target>
</Project>
